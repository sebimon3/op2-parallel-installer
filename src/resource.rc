/* Resource script for op-2.2-mt.exe.
 * The application manifest is generated by build.bat as _op22.manifest so
 * that this directory keeps only the five source deliverables.  It enables
 * ComCtl32 v6 (themed wizard controls) and declares DPI awareness.
 */
1 24 "_op22.manifest"
100 ICON "app.ico"
210 RCDATA "assets\\wizard.bmp"
211 RCDATA "assets\\wizard_small.bmp"
